# Dependencies
frontend/node_modules/
backend/__pycache__/
backend/**/__pycache__/
*.pyc

# Build output
frontend/dist/
backend/static/

# Environment. Every variant, not just the plain name: the file that gets
# committed by accident is never .env itself, it is the copy somebody made
# beside it before an upgrade. A rule matching one exact name leaves every
# one of those visible to `git add -A`, in the same directory as the real
# thing, in a repository that pushes to a public remote.
.env
.env.*
*.env
*.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Temp
theme-preview.html

# Data
/data/
